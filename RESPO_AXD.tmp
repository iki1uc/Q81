// JS/RESPO_AXD.tmp
import { q81 } from "./q81.js";
import { NC, ABC_Vektor } from "./vector.js";
import { CACHE_UPDATE, XI, IX } from "./cache.js";
import { HDF_PATH } from "./hdf.js";

export function RESPO_ID(v, standort, A, B, C) {

    const q = q81(v);
    const vec = ABC_Vektor(A, B, C, standort);
    const nc = NC(standort);

    CACHE_UPDATE(standort, q, vec);
    const hdf = HDF_PATH(nc);

    return {
        typ: "RESPO-ID",
        nc,
        ursprung: q.qualität,
        richtung: q.status,
        länge: q.nenner,
        vektor: vec,
        XI,
        IX,
        hdf_tmp: hdf.tmp,
        cache: hdf.cache,
        id: `${nc}-${q.qualität}-${vec.AC.x}-${vec.AC.y}-${vec.AC.z}`
    };
}
